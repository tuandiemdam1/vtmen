# ==============================================================================
# CẤU HÌNH HỆ THỐNG VTMEN (Copy file này thành .env khi triển khai trên máy mới)
# ==============================================================================

# 1. Cổng chạy dịch vụ (Local)
FRONTEND_PORT=3005
BACKEND_PORT=8085

# 2. Cơ sở dữ liệu MongoDB (Mặc định kết nối MongoDB cài trên máy hoặc Docker)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/vtmen

# 3. Cấu hình kết nối Frontend -> Backend
NEXT_PUBLIC_API_URL=http://localhost:8085/api
NEXT_PUBLIC_WS_URL=http://localhost:8085
NEXT_PUBLIC_DCS_MAP_NAME=@

# 4. Cấu hình máy chủ Robot DCS
DCS_HOST=203.145.47.216
DCS_PORT=8081
DCS_USERNAME=admin
DCS_PASSWORD=123

# 5. Cấu hình Gmail SMTP (Gửi mã PIN mở tủ cho khách hàng)
# Hướng dẫn tạo App Password: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# 6. Cấu hình Ngrok Tunnel (Tùy chọn - dùng khi chạy start-tunnel.bat hoặc npm run dev:tunnel)
# Để trống nếu muốn dùng domain ngẫu nhiên của Ngrok
NGROK_DOMAIN=cabalistic-grisly-kolby.ngrok-free.dev

